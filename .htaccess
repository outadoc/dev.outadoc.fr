Options -Indexes
Options +FollowSymlinks

RewriteEngine on
RewriteRule ^project/([^/\.]+)/?$ view-project.php?name=$1 [L]
RewriteRule ^(.*)\.html$ $1.php [nc]

ErrorDocument 400 http://dev.outadoc.fr/error.php?code=400
ErrorDocument 401 http://dev.outadoc.fr/error.php?code=401
ErrorDocument 403 http://dev.outadoc.fr/error.php?code=403
ErrorDocument 404 http://dev.outadoc.fr/error.php?code=404
ErrorDocument 405 http://dev.outadoc.fr/error.php?code=405
ErrorDocument 406 http://dev.outadoc.fr/error.php?code=406
ErrorDocument 407 http://dev.outadoc.fr/error.php?code=407
ErrorDocument 408 http://dev.outadoc.fr/error.php?code=408
ErrorDocument 410 http://dev.outadoc.fr/error.php?code=410
ErrorDocument 500 http://dev.outadoc.fr/error.php?code=500
ErrorDocument 501 http://dev.outadoc.fr/error.php?code=501
ErrorDocument 502 http://dev.outadoc.fr/error.php?code=502
ErrorDocument 503 http://dev.outadoc.fr/error.php?code=503
ErrorDocument 504 http://dev.outadoc.fr/error.php?code=504
ErrorDocument 505 http://dev.outadoc.fr/error.php?code=505