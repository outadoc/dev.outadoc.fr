{% extends 'base.html.twig' %}
{% form_theme form 'form/fields.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/form.css') }}" rel="stylesheet" type="text/css">
{% endblock %}

{% block title %}
    {% trans from "global" %}Contact{% endtrans %}
{% endblock %}

{% block body %}
    <div class="container">
        {{ form_start(form) }}

        {% if valid %}
            <div class="row">
                <div class="col s12 m12">
                    <div class="card-panel green">
                        <span class="white-text">Your message was sent successfully. Thanks! &#127881;</span>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="row">
                <div class="col s12 m12">
                    {{ form_errors(form) }}
                </div>
            </div>
        {% endif %}

        <div class="row">
            <div class="input-field col s12 m8">
                <i class="mdi-action-account-circle prefix"></i>
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
            </div>

            <div class="col s12 m4">
                {{ form_errors(form.name) }}
            </div>
        </div>

        <div class="row">
            <div class="input-field col s12 m8">
                <i class="mdi-communication-email prefix"></i>
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
            </div>

            <div class="col s12 m4">
                {{ form_errors(form.email) }}
            </div>
        </div>

        <div class="row">
            <div class="input-field col s12 m8">
                <i class="mdi-editor-mode-edit prefix"></i>
                {{ form_label(form.message) }}
                {{ form_widget(form.message, {'attr': {'class': 'materialize-textarea'}}) }}
            </div>

            <div class="col s12 m4">
                {{ form_errors(form.message) }}
            </div>
        </div>

        <div class="row">
            <div class="input-field col s12 m8">
                {{ form_widget(form.recaptcha) }}
            </div>

            <div class="col s12 m4">
                {{ form_errors(form.recaptcha) }}
            </div>
        </div>

        <div class="row">
            <div class="input-field col s12 m8">
                {{ form_label(form.send) }}
                {{ form_widget(form.send, {'attr': {'class': 'btn blue lighten-1 waves-effect waves-light'}}) }}
            </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
