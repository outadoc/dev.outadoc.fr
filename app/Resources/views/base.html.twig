<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>outa[dev] - {% block title %}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    {% block stylesheets %}
        <link href="{{ asset('assets/css/global.css') }}" rel="stylesheet" type="text/css">
        <link href="{{ asset('assets/css/materialize.min.css') }}" rel="stylesheet" type="text/css"
              media="screen,projection">
    {% endblock %}
</head>
<body>
<header>
    {% block header %}
        {% block navbar %}
            <nav class="top-nav blue lighten-1">
                <div class="container">
                    <div class="nav-wrapper">
                        <a class="brand-logo page-title">
                            {% block header_title %}
                                {{ block('title') }}
                            {% endblock %}
                        </a>
                    </div>
                </div>
            </nav>
        {% endblock %}
        <div class="container">
            <a href="#" data-activates="slide-out" class="button-collapse top-nav full">
                <i class="mdi-navigation-menu"></i>
            </a>
        </div>
        <ul id="slide-out" class="side-nav fixed">
            <li class="logo">
                <a id="logo-container" href="{{ url('home') }}" class="brand-logo">
                    outa[dev]
                </a>
            </li>
            <li>
                <a href="{{ path('home') }}" class="waves-effect">
                    <i class="mdi-action-home"></i> Home
                </a>
            </li>
            <li>
                <a href="{{ path('projects') }}" class="waves-effect">
                    <i class="mdi-action-shop-two"></i> Projects
                </a>
            </li>
            <li>
                <a href="{{ path('about') }}" class="waves-effect">
                    <i class="mdi-action-account-circle"></i> About me
                </a>
            </li>
            <li>
                <a href="{{ path('contact') }}" class="waves-effect">
                    <i class="mdi-communication-email"></i> Contact
                </a>
            </li>
        </ul>
    {% endblock %}
</header>
<main>
    {% block body %}{% endblock %}
</main>
{% block javascripts %}
    <script type="text/javascript" src="{{ asset('assets/js/jquery-2.1.4.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('assets/js/materialize.min.js') }}"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $(".button-collapse").sideNav();
        })

    </script>
{% endblock %}
</body>
</html>
