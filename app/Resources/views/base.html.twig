<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>outa[dev] - {% block title %}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="{{ asset('assets/css/global.css') }}" rel="stylesheet" type="text/css">
    <link href="{{ asset('assets/css/materialize.min.css') }}" rel="stylesheet" type="text/css"
          media="screen,projection">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header>
    <nav class="blue lighten-1">
        <div class="container">
            <a href="#" data-activates="slide-out" class="button-collapse"><i class="mdi-navigation-menu"></i></a>

            <div class="nav-wrapper">
                <a class="brand-logo">{{ block('title') }}</a>
            </div>
        </div>
    </nav>
    <ul id="slide-out" class="side-nav fixed">
        <li class="logo">
            <a id="logo-container" href="{{ url('home') }}" class="brand-logo">
                outa[dev]
            </a>
        </li>
        <li><a href="{{ path('home') }}"><i class="mdi-action-home"></i> Home</a></li>
        <li><a href="{{ path('projects') }}"><i class="mdi-action-shop-two"></i> Projects</a></li>
        <li><a href="{{ path('about') }}"><i class="mdi-action-account-circle"></i> About Me</a></li>
        <li><a href="{{ path('contact') }}"><i class="mdi-communication-email"></i> Contact</a></li>
    </ul>
</header>
<main>
    <div class="container">
        {% block body %}{% endblock %}
    </div>
</main>
<script type="text/javascript" src="{{ asset('assets/js/jquery-2.1.4.min.js') }}"></script>
<script type="text/javascript" src="{{ asset('assets/js/materialize.min.js') }}"></script>
<script type="text/javascript">

    $(document).ready(function () {
        $(".button-collapse").sideNav();
    })

</script>
{% block javascripts %}{% endblock %}
</body>
</html>
