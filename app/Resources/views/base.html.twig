<!DOCTYPE html>
{% include 'fragments/topkek.html.twig' %}
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <title>outa[dev] - {% block title %}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#1C8DE8">

    {% block stylesheets %}
        <style type="text/css">
            @font-face {
                font-family: "I pixel u";
                src: url('{{ asset("/assets/font/I-pixel-u.ttf") }}');
            }
        </style>

        <link href="{{ asset('assets/css/global.css') }}" rel="stylesheet" type="text/css">
        <link href="{{ asset('assets/css/materialize.min.css') }}" rel="stylesheet" type="text/css"
              media="screen,projection">
    {% endblock %}
</head>
<body>
<header>
    {% block header %}
        {% block navbar %}
            <nav class="top-nav blue lighten-1">
                <div class="container">
                    <div class="nav-wrapper">
                        <a class="brand-logo page-title">
                            {% block header_title %}
                                {{ block('title') }}
                            {% endblock %}
                        </a>
                    </div>
                </div>
            </nav>
        {% endblock %}
        <div class="container">
            <a href="#" data-activates="slide-out" class="button-collapse top-nav full">
                <i class="mdi-navigation-menu"></i>
            </a>
        </div>
        <ul id="slide-out" class="side-nav fixed">
            <li class="logo">
                <a id="logo-container" href="{{ url('home') }}" class="brand-logo">
                    outa[dev]
                </a>
            </li>
            <li class="separator"></li>
            <li class="{% if app.request.attributes.get('_route') == 'home' %}active{% endif %}">
                <a href="{{ path('home') }}" class="waves-effect">
                    <i class="mdi-action-home"></i> {% trans from "global" %}Home{% endtrans %}
                </a>
            </li>
            <li class="{% if app.request.attributes.get('_route') == 'projects' %}active{% endif %}">
                <a href="{{ path('projects') }}" class="waves-effect">
                    <i class="mdi-action-shop-two"></i> {% trans from "global" %}Projects{% endtrans %}
                </a>
            </li>
            <li class="{% if app.request.attributes.get('_route') == 'about' %}active{% endif %}">
                <a href="{{ path('about') }}" class="waves-effect">
                    <i class="mdi-action-account-circle"></i> {% trans from "global" %}About me{% endtrans %}
                </a>
            </li>
            <li class="{% if app.request.attributes.get('_route') == 'contact' %}active{% endif %}">
                <a href="{{ path('contact') }}" class="waves-effect">
                    <i class="mdi-communication-email"></i> {% trans from "global" %}Contact{% endtrans %}
                </a>
            </li>
            <li class="separator"></li>
            <li class="no-padding">
                <ul class="collapsible collapsible-accordion">
                    <li>
                        <a class="collapsible-header waves-effect">
                            <i class="mdi-social-group"></i> {% trans from "global" %}Social{% endtrans %}
                        </a>

                        <div class="collapsible-body">
                            <ul>
                                <li><a href="https://github.com/outadoc" target="_blank">
                                        Github</a></li>
                                <li><a href="https://twitter.com/outadev" target="_blank">
                                        Twitter</a></li>
                                <li><a href="https://www.linkedin.com/profile/view?id=422529124" target="_blank">
                                        LinkedIn</a></li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </li>
        </ul>
    {% endblock %}
</header>
<main>
    {% block body %}{% endblock %}
</main>
<footer class="page-footer blue lighten-1">
    <div class="footer-copyright">
        <div class="container">
            © 2012 - 2015 Baptiste Candellier (outadoc)
            <div class="right">
                <a class="grey-text text-lighten-4" href="https://github.com/outadoc">{% trans from "global" %}Moar on Github{% endtrans %}</a> -
                <a class="grey-text text-lighten-4" href="https://twitter.com/outadev">Twitter</a>
            </div>
        </div>
    </div>
</footer>
{% block javascripts %}
    <script type="text/javascript" src="{{ asset('assets/js/jquery-2.1.4.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('assets/js/materialize.min.js') }}"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $(".button-collapse").sideNav();
        });

    </script>
{% endblock %}
</body>
</html>
