{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/index.css') }}" rel="stylesheet" type="text/css">
{% endblock %}

{% block title %}
    {% trans from "global" %}Home{% endtrans %}
{% endblock %}

{% block navbar %}
    {# Empty, no navbar wanted here #}
{% endblock %}

{% block body %}
    <div class="col m12 z-depth-1" id="hello"
         style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('assets/img/hello/' ~ screenshot) }}')">
        <div class="title">
            <h2>{% trans from "home" %}Welcome, stranger!{% endtrans %}</h2>
            <h3>{% trans from "home" %}outa[dev], fun open-source projects by Baptiste Candellier, aka outadoc{% endtrans %}</h3>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="material-icons">school</i>
                    <p class="promo-caption">{% trans from "home" %}Amateur Programming{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}I'm a student in computer science making programs for my fun and everybody else's.{% endtrans %}</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="material-icons">share</i>
                    <p class="promo-caption">{% trans from "home" %}Open-Source Software{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}By making most of my projects free and open-source, I hope to give back the community what it has given to me.{% endtrans %}</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="material-icons">favorite</i>
                    <p class="promo-caption">{% trans from "home" %}Fun Everywhere{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}I like to keep discovering new technologies and having fun with them making stuff, useful or not. Have fun too!{% endtrans %}</p>
                </div>
            </div>
        </div>
    </div>

    {# April fools! #}
    {% if 'now'|date('j-n') == '1-4' %}
        <iframe src="http://adultcatfinder.com/embed/" width="320" height="430"
                style="position:fixed;bottom:0;right:10px;z-index:100" frameBorder="0"></iframe>
    {% endif %}
{% endblock %}
