{% extends 'base.html.twig' %}

{% block title %}
    Home
{% endblock %}

{% block body %}
    <div class="col m12 z-depth-1" id="hello"
         style="background-image: linear-gradient( rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5) ),  url('{{ asset('assets/img/hello/android1.png') }}')">
        <div class="title">
            <h2>Welcome, stranger!</h2>

            <h3>outa[dev] is a place for fun open-source projects made by myself, Baptiste Candellier.</h3>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col m4 s12">
                <div class="center promo promo-example">
                    <i class="mdi-image-flash-on"></i>

                    <p class="promo-caption">Speeds up development</p>

                    <p class="light center">We did most of the heavy lifting for you to provide a default stylings that
                        incorporate our custom components.</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo promo-example">
                    <i class="mdi-social-group"></i>

                    <p class="promo-caption">User Experience Focused</p>

                    <p class="light center">By utilizing elements and principles of Material Design, we were able to
                        create a framework that focuses on User Experience.</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo promo-example">
                    <i class="mdi-action-settings"></i>

                    <p class="promo-caption">Easy to work with</p>

                    <p class="light center">We have provided detailed documentation as well as specific code examples to
                        help new users get started.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}