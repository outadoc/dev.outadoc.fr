{% extends 'base.html.twig' %}

{% block title %}
    Home
{% endblock %}

{% block navbar %}
{% endblock %}

{% block body %}
    <div class="col m12 z-depth-1" id="hello"
         style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('assets/img/hello/' ~ screenshot) }}')">
        <div class="title">
            <h2>Welcome, stranger!</h2>

            <h3>outa[dev] is a place for fun open-source projects made by myself, Baptiste Candellier.</h3>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="mdi-social-school"></i>

                    <p class="promo-caption">Amateur Programming</p>

                    <p class="light center">I'm a student in computer science making programs for my fun and everybody
                        else's.</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="mdi-social-share"></i>

                    <p class="promo-caption">Open-Source Software</p>

                    <p class="light center">By making most of my projects free and open-source, I hope to give back to
                        the community what it has given to me.</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="mdi-action-favorite"></i>

                    <p class="promo-caption">Fun Everywhere</p>

                    <p class="light center">I like to keep discovering new technologies and having fun with them by
                        making stuff, useful or not. Have fun too!</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}