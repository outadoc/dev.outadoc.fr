{% extends 'base.html.twig' %}

{% macro format_price(price) %}
    {%- if price == 0 -%}
        Free
    {%- else -%}
        {{- price -}}€
    {%- endif -%}
{% endmacro %}

{% block title %}
    {{ project.getName() }}
{% endblock %}

{% block header_title %}
    {{ parent() }}
    {% if project.getPlatforms() is not empty %}
        <small class="hide-on-small-and-down">for
            {% for platform in project.getPlatforms() %}
                {% if loop.last %}
                    {{ platform }}
                {% else %}
                    {{ platform }},
                {% endif %}
            {% endfor %}
        </small>
    {% endif %}

    {% set mobile_classes = "btn btn-large download yellow darken-1 grey-text text-darken-3 waves-effect hide-on-med-and-down right" %}
    {% set desktop_classes = "btn-floating btn-large waves-effect waves-light yellow darken-1 modal-trigger hide-on-large-only" %}

    {# Download links #}
    {% if project.getDownloads()[0].getPlatform().getName() == 'Web' %}
        {# Website: only show a "go to" link #}
        <a class='{{ mobile_classes }}' href='{{ project.getDownloads()[0].getDownloadUrl() }}'>
            Go to the website
        </a>
        <a data-target="modal-download" class="{{ desktop_classes }} download-fab">
            <i class="mdi-action-open-in-new"></i>
        </a>
    {% else %}
        {# Otherwise, display a dropdown with all the downloads #}
        <a class="dropdown-button {{ mobile_classes }}" href="#"
           data-activates="dropdown-downloads">Download</a>

        <ul id="dropdown-downloads" class="dropdown-content">
            {% for download in project.getDownloads() %}
                <li>
                    <a href="{{ download.getDownloadUrl() }}" class="grey-text text-darken-3">
                        {{ download.getPlatform().getName() }} ({{- _self.format_price(download.getPrice()) -}},
                        v{{ download.getVersion() }})
                    </a>
                </li>
            {% endfor %}
        </ul>

        <a data-target="modal-download" class="{{ desktop_classes }} download-fab"><i
                    class="mdi-action-get-app"></i></a>
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col s12 m12 l5">
                {# <img class="materialboxed" width="300" src="{{ asset('assets/img/data/screen/' ~ project.getSimpleName() ~ '/0.png') }}"> #}
            </div>
            <div class="col s12 m12 l7">
                {{ project.getDescription()|raw }}
            </div>
        </div>
    </div>
    <div id="modal-download" class="modal bottom-sheet">
        <div class="modal-content">
            <h4>Download {{ project.getName() }}</h4>

            <div class="collection">
                {% for download in project.getDownloads() %}
                    <a href="{{ download.getDownloadUrl() }}" class="collection-item avatar">
                        <i class="mdi-file-file-download circle green"></i>
                        <span class="title">{{ download.getPlatform().getName() }}</span>

                        <p>Version {{ download.getVersion() }}<br>
                            {{- _self.format_price(download.getPrice()) -}}
                        </p>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        $('.dropdown-button').dropdown({
                    hover: true,
                    constrain_width: false,
                    belowOrigin: true
                }
        );

        $(document).ready(function () {
            // the "href" attribute of .modal-trigger must specify the modal ID that wants to be triggered
            $('.modal-trigger').leanModal();
        });

    </script>
{% endblock %}