{% extends 'base.html.twig' %}

{% block title %}
    Projects
{% endblock %}

{% block body %}
    {% for category in categories %}
        <h3 class="header">{{ category.getNameLong() }}</h3>
        <div class="row">
            {% for project in category.getProjects() %}
                {% include('fragments/thumbnail.html.twig') %}
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}