{% extends 'base.html.twig' %}

{% block title %}
    Projects
{% endblock %}

{% block top_extra %}
    <div class="container">
        <div class="row">
            {% for project in featured %}
                {% include('fragments/thumbnail.html.twig') %}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block body %}
    {% for category in categories %}
        <h3 class="header">{{ category.getNameLong() }}</h3>
        <div class="row">
            {% for project in category.getProjects() %}
                {% if project.getVisible() %}
                    {% include('fragments/thumbnail.html.twig') %}
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}