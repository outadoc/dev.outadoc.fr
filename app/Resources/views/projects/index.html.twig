{% extends 'base.html.twig' %}

{% block title %}
    Projects
{% endblock %}

{% block header %}
    {{ parent() }}
    <div class="top-extra blue lighten-1">
        <div class="container">
            <div class="row">
                {% for project in featured %}
                    <div class="col s6 m4">
                        {% include('fragments/thumbnail.html.twig') %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container">
        {% for category in categories %}
            <div class="section">
                <h5>{{ category.getNameLong() }}</h5>

                <div class="row">
                    {% for project in category.getProjects() %}
                        {% if project.getVisible() %}
                            <div class="col s6 m3">
                                {% include('fragments/thumbnail.html.twig') %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% if not loop.last %}
                <div class="divider"></div>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}