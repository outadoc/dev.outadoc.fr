{% extends 'base.html.twig' %}

{% block title %}
    Projects
{% endblock %}

{% block top_extra %}
    <div class="container">
        <div class="row">
            {% for project in featured %}
                {% include('fragments/thumbnail.html.twig') %}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container">
        {% for category in categories %}
            <div class="section">
                <h5>{{ category.getNameLong() }}</h5>

                <div class="row">
                    {% for project in category.getProjects() %}
                        {% if project.getVisible() %}
                            {% include('fragments/thumbnail.html.twig') %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% if not loop.last %}
                <div class="divider"></div>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}