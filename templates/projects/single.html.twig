{% extends 'base.html.twig' %}

{% import _self as formatMacro %}

{% macro format_price(price) %}
    {%- if price == 0 -%}
        {% trans from "projects" %}Free{% endtrans %}
    {%- else -%}
        {{- price -}}€
    {%- endif -%}
{% endmacro %}

{% block title %}
    {{ project.getName() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('single-project') }}
{% endblock %}

{% block extended_nav %}
    <div class="nav-content">
        <div class="row">
            <div class="col s12 m9 project-header">
                {# Header: project name, description and dates #}
                <h1 class="header center-on-small-only white-text">{{ project.getName() }}</h1>
                <h4 class="light text-lighten-4 center-on-small-only light-blue-text">
                    {% if app.request.getLocale() == "fr" %}
                        {{ project.getFrenchShortDescription() }}
                    {% else %}
                        {{ project.getShortDescription() }}
                    {% endif %}
                </h4>

                <h4 class="light text-lighten-3 center-on-small-only light-blue-text project-date">
                    {% if project.getEndYear() is null %}
                        {{ project.getStartYear() }}&ndash;{% trans from "projects" %}Today{% endtrans %}
                    {% elseif project.getStartYear() == project.getEndYear() %}
                        {{ project.getStartYear() }}
                    {% else %}
                        {{ project.getStartYear() }}&ndash;{{ project.getEndYear() }}
                    {% endif %}
                </h4>

                {% if project.getDownloads()|length > 0 %}
                    {% set large_classes = "btn btn-large download yellow darken-1 grey-text text-darken-3 waves-effect hide-on-med-and-down" %}
                    {% set medium_classes = "btn-floating btn-large waves-effect waves-light yellow darken-1 modal-trigger hide-on-large-only" %}

                    {# Download links #}
                    {% if project.getDownloads()[0].getPlatform().getName() == 'Web' %}
                        {# Website: only show a "go to" link #}
                        <a class="{{ large_classes }} website-link" target="_blank"
                           href="{{ project.getDownloads()[0].getDownloadUrl() }}">
                            {% trans from "projects" %}Go to the website{% endtrans %}
                        </a>
                        <a id="download-fab" class="{{ medium_classes }}" target="_blank"
                           href="{{ project.getDownloads()[0].getDownloadUrl() }}">
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    {% else %}
                        {# Otherwise, display a dropdown with all the downloads #}
                        <a class="dropdown-trigger {{ large_classes }}" href="#" data-target="dropdown-downloads">
                            {% trans from "projects" %}Download{% endtrans %} <i class="fas fa-caret-down"></i>
                        </a>

                        <ul id="dropdown-downloads" class="dropdown-content">
                            {% for download in project.getDownloads() %}
                                <li>
                                    <a href="{{ download.getDownloadUrl() }}" class="grey-text text-darken-3">
                                        {{ download.getPlatform().getName() }}
                                        ({{- formatMacro.format_price(download.getPrice()) -}},
                                        v{{ download.getVersion() }})
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>

                        <a data-target="modal-download" id="download-fab" class="{{ medium_classes }}">
                            <i class="fas fa-download"></i>
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container project-single">
        <div class="row">
            <div class="col s12 m12 l7 project-description">
                {% if app.request.getLocale() == "fr" %}
                    {{ project.getFrenchDescription()|markdown_to_html }}
                {% else %}
                    {{ project.getDescription()|markdown_to_html }}
                {% endif %}

                {% if has_source_links %}
                    <p class="source-code-links">
                        <em class="grey-text">
                            {% trans from "projects" %}Check out the source code for{% endtrans %}
                            {% for download in project.getDownloads() %}
                                {%- if download.getSourceUrl() != null -%}
                                    {% if not loop.first %},{% endif %}
                                    <a href="{{ download.getSourceUrl() }}">{{ download.getPlatform().getName() }}</a>
                                {%- endif -%}
                            {% endfor %}
                        </em>
                    </p>
                {% endif %}
            </div>

            <div class="col s12 m12 l5">
                <div class="container screenshots">
                    {% if not project.screenshots.empty %}
                        <div class="row">
                            <div class="col s12 m12">
                                <img class="materialboxed screenshot z-depth-1"
                                     src="{{ asset('assets/img/data/screen/' ~ project.screenshots.first.fileName) }}">
                            </div>
                        </div>
                    {% endif %}

                    <div class="row row-centered">
                        {# Display every secondary screenshot under the main one #}
                        {% for screenshot in project.screenshots %}
                            <div class="col s3 m3 col-centered">
                                <img class="materialboxed screenshot z-depth-1"
                                     src="{{ asset('assets/img/data/screen/' ~ screenshot.fileName) }}">
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="modal-download" class="modal bottom-sheet">
        <div class="modal-content">
            <div class="collection-header"><h4>Download {{ project.getName() }}</h4></div>
            <div class="collection">
                {% for download in project.getDownloads() %}
                    <div class="row collection-item avatar">
                        <div class="col s11">
                            <a href="{{ download.getDownloadUrl() }}">
                                <i class="fas fa-download circle blue lighten-1"></i>
                                <span class="title">{{ download.getPlatform().getName() }}</span>

                                <p>Version {{ download.getVersion() }}<br>
                                    {{- formatMacro.format_price(download.getPrice()) -}}
                                </p>
                            </a>
                        </div>
                        <div class="col s1">
                            <a href="{{ download.getSourceUrl() }}" target="_blank" class="secondary-content">
                                <span class="fab fa-github grey-text darken-2"></span>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('single-project') }}
{% endblock %}
