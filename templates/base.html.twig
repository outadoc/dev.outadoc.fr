<!DOCTYPE html>
{% include 'fragments/topkek.html.twig' %}
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <title>outa[dev] - {% block title %}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#1C8DE8">

    {% block stylesheets %}
        <style type="text/css">
            @font-face {
                font-family: "I pixel u";
                src: url('{{ asset("/assets/fonts/I-pixel-u.ttf") }}');
            }
        </style>
        
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.9/css/all.css" integrity="sha384-5SOiIsAziJl6AWe0HWRKTXlfcSHKmYV4RBF18PPJ173Kzn7jzMyFuTtk8JA7QQG1" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0-beta/css/materialize.min.css">

        <link href="{{ asset('assets/css/global.css') }}" rel="stylesheet" type="text/css">
    {% endblock %}
</head>
<body>
<header>
    {% block header %}
        {% block navbar %}
            <nav class="nav-extended  blue lighten-1">
                <div class="container">
                    <div class="nav-wrapper">
                        <a href="{{ url('home') }}" class="brand-logo">outa[dev]</a>
                        <a href="#" data-target="slide-out" class="sidenav-trigger">
                            <i class="fas fa-bars"></i>
                        </a>
                        <ul class="right hide-on-med-and-down">
                            <li class="{% if app.request.attributes.get('_route') == 'home' %}active{% endif %}">
                                <a href="{{ path('home') }}" class="waves-effect">
                                    {% trans from "global" %}Home{% endtrans %}
                                </a>
                            </li>
                            <li class="{% if app.request.attributes.get('_route') == 'projects' %}active{% endif %}">
                                <a href="{{ path('projects') }}" class="waves-effect">
                                    {% trans from "global" %}Projects{% endtrans %}
                                </a>
                            </li>
                            <li class="{% if app.request.attributes.get('_route') == 'about' %}active{% endif %}">
                                <a href="{{ path('about') }}" class="waves-effect">
                                    {% trans from "global" %}About me{% endtrans %}
                                </a>
                            </li>
                            <li class="separator"></li>
                            <li><a href="https://twitter.com/outadev" target="_blank">
                                    <i class="fab fa-twitter"></i></a></li>
                            <li><a href="https://github.com/outadoc" target="_blank">
                                    <i class="fab fa-github"></i></a></li>
                            <li><a href="https://stackoverflow.com/story/candellierba" target="_blank">
                                <i class="fab fa-stack-overflow"></i></a></li>
                            <li><a href="https://www.linkedin.com/in/candellierba" target="_blank">
                                    <i class="fab fa-linkedin"></i></a></li>                    
                        </ul>
                    </div>

                    {% block extended_nav %}
                        <div class="nav-content">
                            <span class="nav-title">
                                    {{ block('title') }}
                            </span>
                        </div>
                    {% endblock %}
                </div>
            </nav>
        {% endblock %}

        <ul id="slide-out" class="sidenav">
            <li class="logo">
                <a id="logo-container" href="{{ url('home') }}" class="brand-logo">
                    outa[dev]
                </a>
            </li>
            <li class="separator"></li>
            <li class="{% if app.request.attributes.get('_route') == 'home' %}active{% endif %}">
                <a href="{{ path('home') }}" class="waves-effect">
                    <i class="fas fa-home"></i> {% trans from "global" %}Home{% endtrans %}
                </a>
            </li>
            <li class="{% if app.request.attributes.get('_route') == 'projects' %}active{% endif %}">
                <a href="{{ path('projects') }}" class="waves-effect">
                    <i class="fab fa-app-store-ios"></i> {% trans from "global" %}Projects{% endtrans %}
                </a>
            </li>
            <li class="{% if app.request.attributes.get('_route') == 'about' %}active{% endif %}">
                <a href="{{ path('about') }}" class="waves-effect">
                    <i class="fas fa-user-circle"></i> {% trans from "global" %}About me{% endtrans %}
                </a>
            </li>
            <li class="separator"></li>
            <li>
                <a class="subheader">{% trans from "global" %}Social{% endtrans %}</a>
            </li>
            <li><a href="https://twitter.com/outadev" target="_blank">
                    <i class="fab fa-twitter"></i> Twitter</a></li>
            <li><a href="https://stackoverflow.com/story/candellierba" target="_blank">
                    <i class="fab fa-stack-overflow"></i> Stack Overflow</a></li>
            <li><a href="https://github.com/outadoc" target="_blank">
                    <i class="fab fa-github"></i> Github</a></li>
            <li><a href="https://www.linkedin.com/in/candellierba" target="_blank">
                    <i class="fab fa-linkedin"></i> LinkedIn</a></li>
        </ul>
    {% endblock %}
</header>
<main>
    {% block body %}{% endblock %}
</main>
<footer class="page-footer blue lighten-1">
    <div class="footer-copyright">
        <div class="container">
            © 2012 - 2018 Baptiste Candellier. Built with Symfony + ❤︎.
        </div>
    </div>
</footer>
{% block javascripts %}
    <script type="text/javascript" src="{{ asset('assets/js/jquery-2.1.4.min.js') }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0-beta/js/materialize.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function(){
            $('.sidenav').sidenav();
        });
    </script>
{% endblock %}
</body>
</html>
