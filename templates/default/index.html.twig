{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('index') }}
{% endblock %}

{% block title %}
    {% trans from "global" %}Home{% endtrans %}
{% endblock %}

{% block extended_nav %}
{% endblock %}

{% block body %}
    <div class="col m12 z-depth-1" id="hello"
         style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('assets/img/hello/' ~ screenshot) }}')">
        <div class="title">
            <h2>{% trans from "home" %}Welcome!{% endtrans %}</h2>
            <h3>{% trans from "home" %}You have successfully reached Baptiste Candellier's software projects portfolio.{% endtrans %}</h3>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="fas fa-heart"></i>
                    <p class="promo-caption">{% trans from "home" %}Fun Everywhere{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}I'm a soon-to-be software engineer making programs for my fun and everybody else's in my free time.{% endtrans %}</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="fas fa-share-alt"></i>
                    <p class="promo-caption">{% trans from "home" %}Open-Source Software{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}By making most of my projects free and open-source, I hope to give back the community what it has given to me.{% endtrans %}</p>
                </div>
            </div>
            <div class="col m4 s12">
                <div class="center promo">
                    <i class="fas fa-flask"></i>
                    <p class="promo-caption">{% trans from "home" %}Experimentation{% endtrans %}</p>
                    <p class="light center">{% trans from "home" %}I like to experiment with new technologies and having fun with them making stuff, useful or not. Have fun too!{% endtrans %}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
